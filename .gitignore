# ============================================================
# Веса и крупные артефакты — не коммитить никогда (AGENTS.md §8)
# ============================================================
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.onnx
artifacts/**
!artifacts/.gitkeep
!artifacts/base/
artifacts/base/**
!artifacts/base/.gitkeep
!artifacts/base/SHA256.txt

# ============================================================
# JSONL: по умолчанию вне git, ниже — правила-исключения.
# ВАЖНО: исключения идут ПОСЛЕ этого правила (побеждает последнее совпадение).
# ============================================================
*.jsonl

# ============================================================
# Датасеты: пускаем только curated текстовые паки — ПРАВИЛОМ, не перечислением.
#
# Раньше здесь был список вида `!datasets/tiny-lora-v0/**` на каждый датасет.
# Список отстал от реальности, и из истории молча выпали tiny-lora-hammer,
# hammer2 (данные флагманской модели), hammer3 и agent. Не возвращать
# перечисление: новый датасет должен попадать в git без правки этого файла.
# ============================================================
datasets/**
!datasets/.gitkeep
!datasets/*.md
!datasets/*/
!datasets/*/*.md
!datasets/*/train.messages.jsonl

# ============================================================
# Eval: промпт-сеты — в git (без них оценки невоспроизводимы).
#
# Доказательная база прогона (ответы модели + паспорт прогона + машинный
# скоринг) тоже в git — иначе цифру в CARD/STATUS нечем перепроверить.
# Per-prompt дампы `<id>.txt` / `<id>.json` остаются снаружи: это тот же
# контент, что и в all.jsonl, только россыпью.
# ============================================================
!eval/prompts.ru.jsonl
!eval/prompts/
!eval/prompts/*.jsonl
eval/results/raw/**
!eval/results/raw/*/
!eval/results/raw/*/all.jsonl
!eval/results/raw/*/meta.json
!eval/results/raw/*/score.json

# ============================================================
# Python / train
# ============================================================
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
wandb/
runs/
outputs/
lora_out/
checkpoints/

# ============================================================
# Closed Sandbox: артефакты прогонов воспроизводимы из project.toml + seed
# ============================================================
sandbox/**/out/
sandbox/**/*.egg-info/
.pytest_cache/
.ruff_cache/

# ============================================================
# OS / IDE / мусор
# ============================================================
.DS_Store
.idea/
.vscode/
*.swp
*.bak
*.orig
screenshot*.png
